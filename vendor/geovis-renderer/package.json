{
  "name": "@geovis/renderer",
  "version": "0.1.0",
  "type": "module",
  "description": "React library for geographic data visualization and interactive maps",
  "keywords": [
    "geo",
    "visualization",
    "map",
    "geojson",
    "gis",
    "cartography",
    "interactive-map",
    "maplibre",
    "react"
  ],
  "author": "Aleksandr Iarkeev <bleizardwhite@gmail.com>",
  "license": "MIT",
  "main": "./dist/geovis-renderer.cjs",
  "module": "./dist/geovis-renderer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/geovis-renderer.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/geovis-renderer.cjs"
      }
    },
    "./style.css": "./dist/geovis-renderer.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "maplibre-gl": "^4.0.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "maplibre-gl": "^5.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@types/polylabel": "^1.1.3",
    "polylabel": "^2.0.1"
  }
}






